    <title>AXIS Camera Station Client</title>
    <authors>Axis Communications AB</authors>
    <projectUrl>https://www.axis.com/products/axis-camera-station</projectUrl>
    <iconUrl>https://github.com/gitwerk/chocolatey-axis-camera-station-package/raw/master/icon.png</iconUrl>
